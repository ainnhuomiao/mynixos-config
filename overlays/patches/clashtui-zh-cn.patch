+#[derive(Clone)]
+pub enum ClashSrvOp {
+    StartClashService,
+    StopClashService,
+    SetPermission,
+    SwitchMode,
+    CloseConnections,
+}
+
+impl From<&str> for ClashSrvOp {
+    fn from(value: &str) -> Self {
+        match value {
+            "启动 Clash 服务" => Self::StartClashService,
+            "停止 Clash 服务" => Self::StopClashService,
+            "设置运行权限" => Self::SetPermission,
+            "切换运行模式" => Self::SwitchMode,
+            "关闭全部连接" => Self::CloseConnections,
+            _ => panic!("Invalid value for conversion"),
+        }
+    }
+}
+
+impl From<ClashSrvOp> for String {
+    fn from(value: ClashSrvOp) -> Self {
+        match value {
+            ClashSrvOp::StartClashService => "启动 Clash 服务".to_string(),
+            ClashSrvOp::StopClashService => "停止 Clash 服务".to_string(),
+            ClashSrvOp::SetPermission => "设置运行权限".to_string(),
+            ClashSrvOp::SwitchMode => "切换运行模式".to_string(),
+            ClashSrvOp::CloseConnections => "关闭全部连接".to_string(),
+        }
+    }
+}
